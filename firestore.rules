rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        ? (userProfile().data.role != null
            ? userProfile().data.role
            : userProfile().data.accountType)
        : null;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'administrator';
    }

    function isFactoryOwner() {
      return isSignedIn() && role() == 'factory_owner';
    }

    function isLogisticsProvider() {
      return isSignedIn() && role() == 'logistics_provider';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in [
          'admin@threadnet.io'
        ];
    }

    function isDealParticipant(dealId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/deals/$(dealId))
        && (
          get(/databases/$(database)/documents/deals/$(dealId)).data.buyerId == request.auth.uid
          || get(/databases/$(database)/documents/deals/$(dealId)).data.sellerId == request.auth.uid
        );
    }

    match /userProfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role in ['factory_owner', 'logistics_provider']
        )
        || (
          isOwner(uid)
          && isBootstrapAdminEmail()
          && request.resource.data.role == 'administrator'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountType == resource.data.accountType
        );
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (isFactoryOwner() || isAdmin())
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            isFactoryOwner()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );

      allow delete: if isAdmin() || (isFactoryOwner() && resource.data.ownerId == request.auth.uid);
    }

    match /deals/{dealId} {
      allow read: if isSignedIn()
        && (
          isAdmin()
          || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != ''
        && request.resource.data.buyerId != request.resource.data.sellerId;

      allow update: if isSignedIn()
        && (
          isAdmin()
          || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.listingId == resource.data.listingId;

      allow delete: if isAdmin();
    }

    match /operations/{operationId} {
      allow read: if isSignedIn() && (isAdmin() || isLogisticsProvider());

      allow create: if isSignedIn()
        && (
          isAdmin()
          || isLogisticsProvider()
          || (
            request.resource.data.dealId is string
            && request.resource.data.dealId != ''
            && isDealParticipant(request.resource.data.dealId)
          )
        );

      // Only logistics providers and admins can update operations.
      allow update: if isSignedIn() && (isAdmin() || isLogisticsProvider());
      allow delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /adminUsers/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /moderationQueue/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /systemHealth/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
